# ==========================================
# ELITE CLOUD HOSTING - ENVIRONMENT TEMPLATE
# ==========================================

# Database Settings (MongoDB Atlas or Local MongoDB)
# Leave as localhost or empty to use automatic embedded in-memory fallback
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=elite_cloud

# Security & Encryption Keys
# Auto-generated if left empty
SECRET_KEY=your_super_secret_jwt_key_here_32_bytes_hex
FERNET_KEY=your_fernet_encryption_key_base64_encoded

# Telegram Bot Integration
# Obtain from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_USERNAME=EliteCloudManagerBot

# Networking & Subdomain Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_URL=http://localhost:8000
STREAMLIT_PORT=8501
BASE_DOMAIN=apps.local
APP_PORT_MIN=8100
APP_PORT_MAX=8900

# Cloudflare Pages (public URLs for static ZIP deployments)
# Create a token with Account > Cloudflare Pages > Edit permission.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_PAGES_ENABLED=true

# Quotas & Limits
MAX_UPLOAD_SIZE_MB=100
MAX_EXTRACTED_SIZE_MB=500
MAX_FILES_PER_ZIP=5000
MAX_CONCURRENT_DEPLOYMENTS=20
DEFAULT_APP_RAM_LIMIT_MB=512
DEFAULT_APP_CPU_LIMIT_PCT=100.0

# Optional Executable Overrides
PYTHON_EXECUTABLE=
NODE_EXECUTABLE=

