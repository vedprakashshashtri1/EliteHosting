FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    nodejs \
    npm \
    && rm -rf /var/lib/apt/lists/*

COPY elite_cloud/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY elite_cloud /app/elite_cloud

ENV PYTHONPATH=/app
ENV API_HOST=0.0.0.0
ENV API_PORT=8000

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "elite_cloud.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
