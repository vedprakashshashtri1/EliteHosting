FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY elite_cloud/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY elite_cloud /app/elite_cloud

ENV PYTHONPATH=/app
ENV STREAMLIT_PORT=8501

EXPOSE 8501

CMD ["streamlit", "run", "elite_cloud/dashboard/app.py", "--server.port", "8501", "--server.address", "0.0.0.0", "--server.headless", "true"]
